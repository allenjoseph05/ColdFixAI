# Copy this file to `.env` (same directory) and put your real key in it.
#
#   cp .env.example .env
#
# `.env` is already covered by the repository's gitignore — verify with:
#   git check-ignore -v spikes/S-0.8-instrument-selection/.env
#
# An existing ANTHROPIC_API_KEY environment variable always takes precedence,
# so this file is a convenience for local runs, not a way to override CI.
ANTHROPIC_API_KEY=sk-ant-replace-me
